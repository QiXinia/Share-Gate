# ===========================================================================
# ChatGPT 账号共享与隔离助手配置文件模板 (示例)
# 复制此文件并重命名为 .env，然后填入您的具体配置。
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Telegram Bot 配置
# ---------------------------------------------------------------------------
# 从 Telegram 官方 @BotFather 处申请到的 Bot API Token。
# 留空或保持默认值时，编排器会自动跳过 Telegram Bot，不影响网页端使用。
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram 访问白名单（强烈建议配置）：允许使用机器人的用户数字 ID，逗号分隔。
# 获取方式：先向机器人发送任意消息，被拒绝时会回复您的 ID。
# 留空 = 任何能找到该机器人的人都能使用（旧行为，有安全风险）。
# 示例：ALLOWED_TELEGRAM_IDS=123456789,987654321
ALLOWED_TELEGRAM_IDS=

# 管理员 ID（可使用 /log 等管理指令）；留空则默认等同白名单。
TELEGRAM_ADMIN_IDS=

# ---------------------------------------------------------------------------
# 2. 浏览器 CDP 配置
# ---------------------------------------------------------------------------
# Chrome / Edge 的远程调试连接地址，通常保持默认即可。
CDP_URL=http://127.0.0.1:9222

# 编排器自动启动浏览器时使用的独立用户数据目录（保持登录态）。
# 留空则使用项目目录下的 chrome-dev-profile/，无需填写。
BROWSER_PROFILE_DIR=

# ---------------------------------------------------------------------------
# 3. 代理配置 (可选)
# ---------------------------------------------------------------------------
# 如网络环境需要代理连接 Telegram / ChatGPT，请配置。
# 支持 HTTP 代理或 socks5 代理（格式示例：http://127.0.0.1:7890）
HTTP_PROXY=
HTTPS_PROXY=

# ---------------------------------------------------------------------------
# 4. Web 服务器与登录安全
# ---------------------------------------------------------------------------
# 监听地址：默认仅本机可访问 (127.0.0.1)。
# 如需让局域网/公网（含 ngrok 隧道）访问，请设为 0.0.0.0 或 ALLOW_REMOTE=True。
# 一旦对外暴露，所有接口都会强制要求登录。
WEB_HOST=127.0.0.1
ALLOW_REMOTE=False

# Web 服务端口（ngrok 隧道会自动跟随此端口）。
WEB_PORT=8501

# 位于 ngrok / 反向代理之后时设为 True，以便正确识别真实 IP 与 HTTPS。
TRUST_FORWARDED_HEADERS=False

# 首次启动自动创建的管理员账户与密码（仅在账户不存在时生效）。
# 请务必修改为一个强密码；之后也可用 `python auth.py passwd` 修改。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 是否允许在登录页自助注册（默认关闭，由管理员通过命令行创建账户）。
ALLOW_REGISTRATION=False

# 登录会话有效期（天）；每用户最多保留的并发会话数。
SESSION_LIFETIME_DAYS=7
MAX_SESSIONS_PER_USER=5

# 登录防爆破：同一 IP 连续失败 N 次后锁定 M 分钟。
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# 独立 Streamlit 控制台的访问密码（留空则使用 ADMIN_PASSWORD）。
STREAMLIT_PASSWORD=

# 上传限制：单次请求体上限（MB）与单次最多文件数。
MAX_UPLOAD_MB=20
MAX_UPLOAD_FILES=5

# 处理 HTTP 请求的最大工作线程数。
WEB_MAX_WORKERS=32

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 5. Ngrok 内网穿透配置 (可选)
# ---------------------------------------------------------------------------
# 是否启用 ngrok 以提供公网访问（True / False）。
# 【安全提醒】启用隧道时请务必：
#   1) 设置 ADMIN_PASSWORD 并完成登录保护；
#   2) 建议将 TRUST_FORWARDED_HEADERS=True；
#   3) 配置 Telegram 白名单。
USE_NGROK=True

# ngrok 可执行文件路径。
# ⚠️【非常重要】Windows 路径千万不要用双引号包裹，否则 "\n" 会被误解析为换行符！
# 正确写法：NGROK_PATH=C:\Users\YourUser\Desktop\ngrok\ngrok.exe
NGROK_PATH=

# 固定域名（ngrok-free.app）；留空则每次随机分配。
NGROK_TUNNEL_URL=
