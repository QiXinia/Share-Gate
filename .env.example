# ===========================================================================
# ChatGPT 账号共享与隔离助手配置文件模板 (示例)
# 复制此文件并重命名为 .env，然后填入您的具体配置。
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. 钉钉机器人配置（企业内部应用 · Stream 长连接模式，无需公网回调）
# ---------------------------------------------------------------------------
# 创建步骤：
#   1) 登录钉钉开放平台 (open.dingtalk.com) → 应用开发 → 创建「企业内部应用」
#   2) 在应用能力中添加「机器人」，消息接收模式选择「Stream 模式」
#   3) 在「凭证与基础信息」中复制 Client ID（AppKey）与 Client Secret（AppSecret）
#   4) 发布应用，并把机器人添加到单聊或群聊
# 留空或保持默认值时，编排器会自动跳过钉钉机器人，不影响网页端使用。
DINGTALK_APP_KEY=YOUR_APP_KEY_HERE
DINGTALK_APP_SECRET=YOUR_APP_SECRET_HERE
# robotCode 一般与 AppKey 相同，通常无需填写。
DINGTALK_ROBOT_CODE=

# 钉钉访问白名单（强烈建议配置）：允许使用机器人的用户 ID（staffId 或 unionId），逗号分隔。
# 获取方式：先向机器人发送任意消息，被拒绝时会回复您的 ID。
# 留空 = 任何能与该机器人会话的人都能使用（旧行为，有安全风险）。
# 示例：ALLOWED_DINGTALK_IDS=staff001,staff002
ALLOWED_DINGTALK_IDS=

# 管理员 ID（可使用 /log 等管理指令）；留空则默认等同白名单。
DINGTALK_ADMIN_IDS=

# ---------------------------------------------------------------------------
# 2. 浏览器 CDP 配置
# ---------------------------------------------------------------------------
# Chrome / Edge 的远程调试连接地址，通常保持默认即可。
CDP_URL=http://127.0.0.1:9222

# 编排器自动启动浏览器时使用的独立用户数据目录（保持登录态）。
# 留空则使用项目目录下的 chrome-dev-profile/，无需填写。
BROWSER_PROFILE_DIR=

# 启用的 AI 平台（逗号分隔）。可选：chatgpt、gemini
#   仅 ChatGPT：           AI_PLATFORMS=chatgpt
#   同时启用 ChatGPT/Gemini：AI_PLATFORMS=chatgpt,gemini
# 启用 gemini 后，启动器会额外打开 gemini.google.com 标签页，请在该页面用 Google 账号登录一次。
AI_PLATFORMS=chatgpt

# 客户端未显式选择平台时使用的默认平台（chatgpt / gemini）。
DEFAULT_PLATFORM=chatgpt

# ---------------------------------------------------------------------------
# 3. 代理配置 (可选)
# ---------------------------------------------------------------------------
# 如网络环境需要代理连接钉钉开放平台 / ChatGPT，请配置。
# 支持 HTTP 代理或 socks5 代理（格式示例：http://127.0.0.1:7890）
HTTP_PROXY=
HTTPS_PROXY=

# ---------------------------------------------------------------------------
# 4. Web 服务器与登录安全
# ---------------------------------------------------------------------------
# 监听地址：默认仅本机可访问 (127.0.0.1)。
# 如需让局域网/公网（含 ngrok 隧道）访问，请设为 0.0.0.0 或 ALLOW_REMOTE=True。
# 一旦对外暴露，所有接口都会强制要求登录。
WEB_HOST=127.0.0.1
ALLOW_REMOTE=False

# Web 服务端口（ngrok 隧道会自动跟随此端口）。
WEB_PORT=8501

# 位于 ngrok / 反向代理之后时设为 True，以便正确识别真实 IP 与 HTTPS。
TRUST_FORWARDED_HEADERS=False

# 首次启动自动创建的管理员账户与密码（仅在账户不存在时生效）。
# 请务必修改为一个强密码；之后也可用 `python auth.py passwd` 修改。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 是否允许在登录页自助注册（默认关闭，由管理员通过命令行创建账户）。
ALLOW_REGISTRATION=False

# 登录会话有效期（天）；每用户最多保留的并发会话数。
SESSION_LIFETIME_DAYS=7
MAX_SESSIONS_PER_USER=5

# 登录防爆破：同一 IP 连续失败 N 次后锁定 M 分钟。
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# 独立 Streamlit 控制台的访问密码（留空则使用 ADMIN_PASSWORD）。
STREAMLIT_PASSWORD=

# 上传限制：单次请求体上限（MB）与单次最多文件数。
MAX_UPLOAD_MB=20
MAX_UPLOAD_FILES=5

# 处理 HTTP 请求的最大工作线程数。
WEB_MAX_WORKERS=32

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 5. Ngrok 内网穿透配置 (可选)
# ---------------------------------------------------------------------------
# 是否启用 ngrok 以提供公网访问（True / False）。
# 【安全提醒】启用隧道时请务必：
#   1) 设置 ADMIN_PASSWORD 并完成登录保护；
#   2) 建议将 TRUST_FORWARDED_HEADERS=True；
#   3) 配置钉钉白名单（ALLOWED_DINGTALK_IDS）。
USE_NGROK=True

# ngrok 可执行文件路径。
# ⚠️【非常重要】Windows 路径千万不要用双引号包裹，否则 "\n" 会被误解析为换行符！
# 正确写法：NGROK_PATH=C:\Users\YourUser\Desktop\ngrok\ngrok.exe
NGROK_PATH=

# 固定域名（ngrok-free.app）；留空则每次随机分配。
NGROK_TUNNEL_URL=
