# ===========================================================================
# ChatGPT 账号共享与隔离助手配置文件模板 (示例)
# 复制此文件并重命名为 .env，然后填入您的具体配置。
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. Telegram Bot 配置
# ---------------------------------------------------------------------------
# 从 Telegram 官方 @BotFather 处申请到的 Bot API Token。
# 【重要容错】：如果您只打算使用 Streamlit 网页端，可以将此项留空或保持默认值，
# 编排器启动时会自动检测并跳过 Telegram Bot，不影响网页端（Streamlit）的正常使用。
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# ---------------------------------------------------------------------------
# 2. 浏览器 CDP 配置
# ---------------------------------------------------------------------------
# Chrome 或 Edge 的远程调试端口连接 URL，通常保持默认即可。
CDP_URL=http://127.0.0.1:9222

# ---------------------------------------------------------------------------
# 3. 代理配置 (可选)
# ---------------------------------------------------------------------------
# 如果您的网络环境需要通过科学上网代理连接 Telegram API，请配置此项。
# 支持 HTTP 代理或 socks5 代理（格式示例：http://127.0.0.1:7890）
HTTP_PROXY=
HTTPS_PROXY=

# ---------------------------------------------------------------------------
# 4. Ngrok 内网穿透配置 (可选)
# ---------------------------------------------------------------------------
# 是否启用 ngrok 内网穿透以提供公网访问 Streamlit Web 界面（True / False）。
# 若设为 True 且未配置 NGROK_PATH，系统将自动尝试从系统 PATH 和项目根目录搜寻 ngrok。
USE_NGROK=True

# ngrok 可执行文件 (ngrok.exe) 的本地自定义路径。
# ⚠️【非常重要】：Windows 路径千万不要用双引号包裹！
# 因为在双引号中，解析器会将 "\n" (如 "\ngrok.exe" 中的 \n) 误解析为“换行符”，导致路径检测失败。
# 正确写法 (直接写路径，无双引号)：
# NGROK_PATH=C:\Users\YourUser\Desktop\ngrok\ngrok.exe
# 错误写法 (带双引号，会导致路径失效)：
# NGROK_PATH="C:\Users\YourUser\Desktop\ngrok\ngrok.exe"
NGROK_PATH=

# 如果您拥有 ngrok 的静态/固定域名 (ngrok-free.app 域名)，请在此处填入：
# 留空则每次随机分配公网穿透 URL。
NGROK_TUNNEL_URL=main-faithful-lion.ngrok-free.app
